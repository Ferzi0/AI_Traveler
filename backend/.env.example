PROJECT_NAME=AI Traveler API
PROJECT_VERSION=0.1.0
API_V1_PREFIX=/api/v1

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_traveler

JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=false

# Локальные URL (совпадают с frontend/src/config.ts)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Travelpayouts / Aviasales Data API (https://support.travelpayouts.com/hc/ru/categories/200358578)
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_CURRENCY=rub
TRAVELPAYOUTS_MARKET=ru
