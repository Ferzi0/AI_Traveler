FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE=https://ai-traveler-0jhd.onrender.com/api/v1
ARG VITE_FRONTEND_URL=https://ai-traveler-1.onrender.com
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_FRONTEND_URL=$VITE_FRONTEND_URL

RUN npm run build

FROM node:22-alpine

WORKDIR /app

RUN npm install -g serve@14

COPY --from=build /app/dist /app/dist

EXPOSE 5173

CMD ["sh", "-c", "serve -s dist -l ${PORT:-5173}"]
